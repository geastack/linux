{
  "name": "@geastack/linux",
  "version": "0.1.2",
  "description": "Native SDL2 targets for Raspberry Pi OS and Sailfish OS GeaStack apps.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geastack/linux.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "targets",
    "!targets/**/dist/**",
    "!targets/**/build/**",
    "!targets/**/generated/**",
    "!targets/**/*.log",
    "!targets/**/test/**",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@geastack/compiler": "^1.0.22",
    "@geastack/core": "^0.1.37",
    "@geastack/geatsc-plugin-gea": "^0.1.19",
    "sharp": "^0.35.5"
  },
  "scripts": {
    "test": "for f in $(git ls-files | grep -E '(^|/)(test[-_][^/]*|[^/]*\\.test)\\.mjs$'); do echo \"==> $f\"; node \"$f\" || exit 1; done"
  }
}
